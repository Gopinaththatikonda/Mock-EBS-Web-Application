# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=production

# EBS application port (8080/8081 are reserved and rejected).
PORT=8090

# PostgreSQL. Inside Docker Compose DB_HOST is forced to "postgres" (the service name).
# Use DB_HOST=localhost only when running "npm start" directly on the host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ebs
DB_USER=ebs_user
DB_PASSWORD=your_password

# EBS application session. Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret
SESSION_TTL_MINUTES=30
# true when users reach Nginx over HTTPS
COOKIE_SECURE=false

# MFA gateway enforcement inside the app (defence in depth; OAuth2 Proxy is the primary control).
# true = EBS APIs reject requests without OAuth2 Proxy identity headers.
REQUIRE_GATEWAY_AUTH=false
# e.g. EBS_ACCESS - requires OAuth2 Proxy to forward groups (X-Forwarded-Groups). Empty = off.
REQUIRED_GATEWAY_GROUP=

# Logout ends ALL sessions: app session, then the browser goes here to end the OAuth2 Proxy
# session. Configure OAuth2 Proxy --backend-logout-url so Keycloak's session ends as well.
GATEWAY_LOGOUT_URL=/oauth2/sign_out?rd=%2F

# pgAdmin (http://<server>:5050). Use a valid-looking email address.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# Host interfaces to publish on. Keep 127.0.0.1 unless remote access is really required.
EBS_BIND=127.0.0.1
PGADMIN_BIND=127.0.0.1
# Host port for PostgreSQL (always 127.0.0.1). Change only if 5432 is already used on the host.
POSTGRES_HOST_PORT=5432
